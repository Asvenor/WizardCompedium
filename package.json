{
  "name": "ultimate-wizard-compendium",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build:astro": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "test": "node --test scripts/test-vault.mjs scripts/test-pdf-sheet-document.mjs scripts/test-cloudflare-config.mjs scripts/test-legacy-redirects.mjs",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "validate:content": "node scripts/validate-vault.mjs",
    "validate:build": "node scripts/validate-build.mjs",
    "audit:fidelity": "node scripts/validate-vault.mjs",
    "prepare:import": "node scripts/prepare-pdf-assets.mjs",
    "sync:vault": "node scripts/import-vault.mjs",
    "test:vault:browser": "playwright test vault-overhaul.spec.mjs",
    "predev": "npm run prepare:import",
    "prebuild": "npm run prepare:import",
    "prebuild:astro": "npm run prepare:import",
    "precheck": "npm run prepare:import",
    "test:audit": "playwright test vault-overhaul.spec.mjs",
    "test:pdf": "node --test scripts/test-pdf-sheet-document.mjs",
    "test:pdf:storage": "node --test scripts/test-pdf-sheet-storage.mjs",
    "test:pdf:browser": "playwright test pdf-sheet.spec.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.0",
    "@astrojs/check": "^0.9.10",
    "astro": "^7.3.1",
    "github-slugger": "2.0.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "^6.3.289",
    "typescript": "^6.0.3",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "wrangler": "4.129.1"
  }
}
