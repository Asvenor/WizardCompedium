---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import SpellCard from '@/components/spells/SpellCard.astro';

const entries = await getCollection('spells');
const spells = entries.map((entry) => entry.data).sort((a, b) => a.level - b.level || a.name.localeCompare(b.name));
const levels = [...new Set(spells.map((spell) => spell.level))].sort((a, b) => a - b);
const sources = [...new Set(spells.map((spell) => spell.source.category))].sort();
---
<BaseLayout title="Spell Database" description="Canonical structured spell records derived from the Compendium's maintained spell pool and spell indexes." active="spells">
  <header class="page-hero"><div class="site-shell"><p class="kicker">Canonical spell records</p><h1>Spell Database</h1><p>Search the maintained Compendium pool by level, acquisition role, concentration, and source. Complete rules wording remains in the active spell entry.</p></div></header>
  <section class="section">
    <div class="site-shell">
      <div class="spell-toolbar" data-spell-toolbar>
        <input class="field" type="search" placeholder="Search spells, roles, or summaries…" aria-label="Search spells" data-spell-search />
        <select class="field" aria-label="Spell level" data-spell-level><option value="">All levels</option>{levels.map((level) => <option value={level}>{level === 0 ? 'Cantrips' : `Level ${level}`}</option>)}</select>
        <select class="field" aria-label="Acquisition role" data-spell-role><option value="">All roles</option><option value="mandatory">Mandatory</option><option value="optional">Optional</option><option value="sleeper">Sleeper</option><option value="unclassified">Unclassified</option></select>
        <select class="field" aria-label="Source category" data-spell-source><option value="">All sources</option>{sources.map((source) => <option value={source}>{source}</option>)}</select>
        <select class="field" aria-label="Concentration" data-spell-concentration><option value="">Any concentration</option><option value="true">Concentration</option><option value="false">No concentration</option></select>
      </div>
      <p class="spell-count" aria-live="polite"><span data-spell-count>{spells.length}</span> spells shown</p>
      <div class="spell-results" data-spell-results>{spells.map((spell) => <SpellCard spell={spell} />)}</div>
    </div>
  </section>
  <script>
    const toolbar = document.querySelector<HTMLElement>('[data-spell-toolbar]');
    const cards = [...document.querySelectorAll<HTMLElement>('[data-spell-card]')];
    const count = document.querySelector<HTMLElement>('[data-spell-count]');
    if (toolbar && count) {
      const controls = {
        search: toolbar.querySelector<HTMLInputElement>('[data-spell-search]'),
        level: toolbar.querySelector<HTMLSelectElement>('[data-spell-level]'),
        role: toolbar.querySelector<HTMLSelectElement>('[data-spell-role]'),
        source: toolbar.querySelector<HTMLSelectElement>('[data-spell-source]'),
        concentration: toolbar.querySelector<HTMLSelectElement>('[data-spell-concentration]'),
      };
      if (Object.values(controls).some((control) => !control)) throw new Error('Spell filter controls are incomplete.');
      const update = () => {
        let visible = 0;
        cards.forEach((card) => {
          const matches = (!controls.search!.value || (card.dataset.search ?? '').includes(controls.search!.value.toLowerCase()))
            && (!controls.level!.value || card.dataset.level === controls.level!.value)
            && (!controls.role!.value || card.dataset.role === controls.role!.value)
            && (!controls.source!.value || card.dataset.source === controls.source!.value)
            && (!controls.concentration!.value || card.dataset.concentration === controls.concentration!.value);
          card.hidden = !matches;
          if (matches) visible += 1;
        });
        count.textContent = String(visible);
      };
      Object.values(controls).forEach((control) => control!.addEventListener(control!.tagName === 'INPUT' ? 'input' : 'change', update));
    }
  </script>
</BaseLayout>
