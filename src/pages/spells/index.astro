---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Catalog from '@/components/Catalog.astro';
import {hrefFor} from '@/lib/vault';
---
<BaseLayout title="Spell finder" active="spells" wide><div class="page-shell"><header class="page-header"><p class="eyebrow">THE SPELLBOOK</p><h1>A spell for the situation.</h1><p>Compare the vault’s selected spell cards by level, casting time, role, and source. Each card keeps its access requirements and practical limits.</p><div class="toolbar"><a class="button" href={hrefFor('Prepared Loadouts')}>Prepared loadouts</a><a class="button" href={hrefFor('Spell Bank')}>Spell acquisition</a><a href={hrefFor('Spell Progression Hub')}>What to learn at each level →</a></div></header><Catalog kind="spells"/></div></BaseLayout>
