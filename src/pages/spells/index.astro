---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { getAcquisitionLanes } from '@/lib/acquisition';
const lanes = await getAcquisitionLanes();
import SpellCard from '@/components/spells/SpellCard.astro';
import { buildLabel, getSpellRoleCategories } from '@/lib/spells';

const entries = await getCollection('spells');
const spells = entries
  .map((entry) => entry.data)
  .sort((a, b) => a.level - b.level || a.name.localeCompare(b.name));
const levels = [...new Set(spells.map((spell) => spell.level))].sort(
  (a, b) => a - b,
);
const sources = [
  ...new Set(spells.map((spell) => spell.source.category)),
].sort();
const roleCategories = [
  ...new Set(spells.flatMap(getSpellRoleCategories)),
].sort();
const buildRelevance = [
  ...new Set(
    spells.flatMap((spell) => spell.compendium.buildRelevance.map(buildLabel)),
  ),
].sort();
const damageTypes = [
  ...new Set(spells.flatMap((spell) => spell.rules.damageTypes)),
].sort();
const roleLabels: Record<string, string> = {
  'anti-caster': 'Anti-Caster',
  control: 'Control',
  damage: 'Damage',
  defense: 'Defense',
  information: 'Information',
  mobility: 'Mobility',
  summoning: 'Summoning',
  utility: 'Utility',
};
---

<BaseLayout
  title="Spell Database"
  description="Canonical structured spell records derived from the Compendium's maintained spell pool and spell indexes."
  active="spells"
>
  <header class="page-hero">
    <div class="site-shell">
      <p class="kicker">Find the right job for a spell</p><h1>
        Spell Database
      </h1><p>
        Filter by tactical role, compare options, then open the full reasoning.
        Unknown mechanics stay unlisted; check the active spell entry.
      </p><div class="hero-actions">
        <a class="button button--primary" href="/spells/compare/"
          >Compare spells</a
        ><a class="button" href="/prepare/">Prepare a mission list</a>
      </div>
    </div>
  </header>
  <section class="section">
    <div class="site-shell">
      <div class="spell-toolbar" data-spell-toolbar>
        <div class="spell-filter-primary">
          <input
            class="field"
            type="search"
            placeholder="Search spells, roles, or summaries…"
            aria-label="Search spells"
            data-spell-search
          />
          <select class="field" aria-label="Spell level" data-filter="level"
            ><option value="">All levels</option>{
              levels.map((level) => (
                <option value={level}>
                  {level === 0 ? 'Cantrips' : `Level ${level}`}
                </option>
              ))
            }</select
          >
          <select class="field" aria-label="Tier" data-filter="tier"
            ><option value="">All tiers</option><option value="s">S / S+</option
            ><option value="a">A</option><option value="b">B</option><option
              value="c">C</option
            ><option value="d-f">D / F</option></select
          >
          <select
            class="field"
            aria-label="Optimization role"
            data-filter="role-category"
            ><option value="">All optimization roles</option>{
              roleCategories.map((role) => (
                <option value={role}>{roleLabels[role] ?? role}</option>
              ))
            }</select
          >
        </div>
        <details class="spell-filter-panel">
          <summary>More filters</summary>
          <div class="spell-filter-more">
            <select
              class="field"
              aria-label="Acquisition role"
              data-filter="role"
              ><option value="">Any acquisition role</option><option
                value="mandatory">Mandatory</option
              ><option value="optional">Optional</option><option value="sleeper"
                >Sleeper</option
              ><option value="unclassified">Unclassified</option></select
            >
            <select
              class="field"
              aria-label="Concentration"
              data-filter="concentration"
              ><option value="">Any concentration</option><option value="true"
                >Concentration: Yes</option
              ><option value="false">Concentration: No</option></select
            >
            <select class="field" aria-label="Ritual" data-filter="ritual"
              ><option value="">Any ritual status</option><option value="true"
                >Ritual: Yes</option
              ><option value="false">Ritual: No</option></select
            >
            <select class="field" aria-label="Saving throw" data-filter="save"
              ><option value="">Any save</option>{
                ['STR', 'DEX', 'CON', 'INT', 'WIS', 'CHA'].map((save) => (
                  <option value={save.toLowerCase()}>{save} save</option>
                ))
              }<option value="none">No listed save</option><option value="ac"
                >AC / spell attack</option
              ><option value="unknown">Save not indexed</option></select
            >
            <select class="field" aria-label="Attack roll" data-filter="attack"
              ><option value="">Any attack type</option><option
                value="spell-attack">Spell attack</option
              ><option value="no-attack">No spell attack</option></select
            >
            <select class="field" aria-label="Action type" data-filter="action"
              ><option value="">Any casting time</option><option value="action"
                >Action</option
              ><option value="bonus-action">Bonus Action</option><option
                value="reaction">Reaction</option
              ><option value="long-cast">Long Cast / Ritual</option></select
            >
            <select
              class="field"
              aria-label="Source category"
              data-filter="source"
              ><option value="">All sources</option>{
                sources.map((source) => (
                  <option value={source}>{source}</option>
                ))
              }</select
            >
            {
              buildRelevance.length > 0 && (
                <select
                  class="field"
                  aria-label="Build relevance"
                  data-filter="build"
                >
                  <option value="">Any indexed build relevance</option>
                  {buildRelevance.map((build) => (
                    <option value={build.toLowerCase()}>{build}</option>
                  ))}
                </select>
              )
            }
            {
              damageTypes.length > 0 && (
                <select
                  class="field"
                  aria-label="Damage type"
                  data-filter="damage"
                >
                  <option value="">Any damage type</option>
                  {damageTypes.map((type) => (
                    <option value={type.toLowerCase()}>{type}</option>
                  ))}
                </select>
              )
            }
            <select
              class="field"
              aria-label="Acquisition lane"
              data-filter="lane"
              ><option value="">Any source lane</option><option value="learn"
                >Learn on level-up</option
              ><option value="copy">Copy-first</option><option value="mission"
                >Mission prep</option
              ><option value="build">Build / table</option></select
            >
            <select class="field" aria-label="My spells" data-filter="personal"
              ><option value="">All spells</option><option value="prepared"
                >My prepared spells</option
              ><option value="owned">My owned spells</option></select
            >
            <select
              class="field"
              aria-label="Recorded range"
              data-filter="range"
              ><option value="">Any recorded range</option>{
                [...new Set(spells.map((s) => s.rules.range ?? 'unknown'))]
                  .sort()
                  .map((range) => (
                    <option value={range}>
                      {range === 'unknown' ? 'Range not indexed' : range}
                    </option>
                  ))
              }</select
            >
            <button class="button" type="button" data-clear-filters
              >Clear filters</button
            >
          </div>
        </details>
      </div>
      <p class="control-note">
        “My spells” uses your local list. No listed save is not a guarantee
        against Legendary Resistance; verify the effect. <a
          href="/wizard/spellbook/">Plan learning and copying →</a
        >
      </p>
      <p class="spell-count" aria-live="polite">
        <span data-spell-count>{spells.length}</span> spells shown
      </p>
      <p class="empty-state" data-spell-empty hidden>
        No canonical spell records match these filters.
      </p>
      <div class="spell-results" data-spell-results>
        {
          spells.map((spell) => (
            <SpellCard spell={spell} lane={lanes[spell.id]} />
          ))
        }
      </div>
    </div>
  </section>
  <script>
    import '@/features/spells/filters';
  </script>
</BaseLayout>
