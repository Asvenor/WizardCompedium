---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import TierBadge from '@/components/TierBadge.astro';
import BuildBadge from '@/components/BuildBadge.astro';
import chapters from '@/data/chapters.json';

export async function getStaticPaths() {
  const spells = await getCollection('spells');
  return spells.map((entry) => ({ params: { id: entry.data.id }, props: { spell: entry.data } }));
}
const { spell } = Astro.props;
const levelLabel = spell.level === 0 ? 'Cantrip' : `Level ${spell.level}`;
const stat = (label: string, value: string | null) => ({ label, value: value ?? 'Not restated in Compendium index' });
const buildBadgeMap: Record<string, 'core' | 'chron' | 'div' | 'ill' | 'blade' | 'tank' | 'fighter'> = { bladesinger: 'blade' };
const stats = [
  stat('Level / school', `${levelLabel}${spell.school ? ` · ${spell.school}` : ''}`),
  stat('Casting time', spell.rules.castingTime),
  stat('Range', spell.rules.range),
  stat('Area', spell.rules.area),
  stat('Duration', spell.rules.duration),
  stat('Save / attack', spell.rules.attackRoll ? 'Spell attack' : spell.rules.save.ability ? `${spell.rules.save.ability} save` : spell.rules.save.type),
];
---
<BaseLayout title={spell.name} description={spell.compendium.summary} active="spells">
  <div class="site-shell docs-grid" style="grid-template-columns:minmax(0,var(--article)) 13rem;justify-content:center">
    <article class="article" data-pagefind-body>
      <div class="breadcrumbs"><a href="/">Home</a><span>/</span><a href="/spells/">Spells</a><span>/</span><span>{spell.name}</span></div>
      <header class="article-header">
        <div class="page-meta">
          <span class="meta-pill">{levelLabel}</span>
          {spell.compendium.tier && <TierBadge tier={spell.compendium.tier} />}
          <span class={`badge badge--${spell.compendium.acquisitionRole}`}>{spell.compendium.acquisitionRole}</span>
          {spell.rules.concentration && <span class="badge badge--concentration">Concentration</span>}
          {spell.rules.ritual && <span class="badge badge--ritual">Ritual</span>}
        </div>
        <h1 data-pagefind-meta="title">{spell.name}</h1>
        <p>{spell.compendium.summary}</p>
      </header>
      <div class="spell-detail-grid">{stats.map((item) => <div class="spell-stat"><small>{item.label}</small><strong>{item.value}</strong></div>)}</div>
      <div class="prose">
        <h2>Compendium role</h2>
        <p><strong>Acquisition:</strong> {spell.compendium.acquisitionRole}. {spell.compendium.preparedBaseline ? 'Marked in the prepared / known baseline.' : 'Not marked in the supplied prepared / known baseline.'}</p>
        {spell.compendium.roles.length > 0 && <p><strong>Roles:</strong> {spell.compendium.roles.join(', ')}.</p>}
        {spell.compendium.buildRelevance.length > 0 && <p><strong>Build relevance:</strong> {spell.compendium.buildRelevance.map((build) => <BuildBadge build={buildBadgeMap[build] ?? 'core'} label={build} />)}</p>}
        <h2>Source status</h2>
        <p><strong>{spell.source.category}</strong> · {spell.source.book ?? 'Use the active source entry'} · {spell.source.rulesVersion}.</p>
        <h2>Warnings</h2>
        <ul class="warning-list">{spell.compendium.warnings.map((warning) => <li>{warning}</li>)}</ul>
        <h2>Related Compendium chapters</h2>
        <div class="chapter-chips">{spell.compendium.relatedChapters.map((number) => { const chapter = chapters.find((item) => item.number === number); return chapter && <a class="chapter-chip" href={`/chapters/${chapter.slug}/`}>Ch. {number} · {chapter.title}</a>; })}</div>
      </div>
    </article>
    <aside class="toc"><h2>Record ownership</h2><p style="font-size:.8rem;color:var(--ink-faint)">This page is generated from <strong>{spell.id}.json</strong>. Change that one record to update reusable spell views.</p></aside>
  </div>
</BaseLayout>
