---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import {getSections,hrefFor} from '@/lib/vault';
---
<BaseLayout title="Search the compendium" active="search"><div class="page-shell search-page"><header class="page-header"><p class="eyebrow">FIND THE RIGHT ANSWER</p><h1>Search the compendium</h1><p>Search every spell, build, table, and reference.</p></header><form class="filter-bar" role="search" data-full-search><label class="field-label"><span>Search</span><input class="field" type="search" name="q" data-search-input placeholder="A spell, a problem, a rule…" autocomplete="off" autofocus/></label><label class="field-label"><span>Section</span><select class="field" name="section"><option value="">Everything</option>{getSections().filter(s=>s.id!=='inbox').map(s=><option value={s.id}>{s.label}</option>)}</select></label><button class="button button--primary" type="submit">Search</button></form><p class="control-note" role="status" aria-live="polite" data-search-status>Enter a name or phrase to begin.</p><div data-search-results class="search-results"></div><div data-search-intro><p class="eyebrow">QUICK REFERENCES</p><div class="related-links">{['Spell Progression Hub','Combat Dashboard','Concentration','Countering Spellcasters','Rules Desk'].map(name=><a href={hrefFor(name)}>{name}<span aria-hidden="true">↗</span></a>)}</div></div><button class="button" type="button" data-search-retry hidden>Retry search</button><noscript><p>Full-text search needs JavaScript. You can <a href="/library/">browse every reference in the library</a>.</p></noscript></div>
  <script>
    import {indexSearch,normalizeSearch,searchRecords,type IndexedRecord,type SearchRecord} from '@/lib/search';
    const form=document.querySelector<HTMLFormElement>('[data-full-search]')!,input=form.elements.namedItem('q') as HTMLInputElement,section=form.elements.namedItem('section') as HTMLSelectElement;
    const output=document.querySelector('[data-search-results]')!,status=document.querySelector('[data-search-status]')!,intro=document.querySelector<HTMLElement>('[data-search-intro]')!,retry=document.querySelector<HTMLButtonElement>('[data-search-retry]')!;
    const params=new URLSearchParams(location.search);input.value=params.get('q')??'';section.value=params.get('section')??'';
    let records:IndexedRecord[]|undefined,pending:Promise<void>|undefined,revision=0,timer:number;
    async function run(){const current=++revision;const raw=input.value.trim();const q=normalizeSearch(raw);const url=new URL(location.href);for(const[k,v]of[['q',raw],['section',section.value]]){if(v)url.searchParams.set(k,v);else url.searchParams.delete(k);}history.replaceState(null,'',url);retry.hidden=true;intro.hidden=!!q;output.replaceChildren();if(!q){status.textContent='Enter a name or phrase to begin.';return;}status.textContent='Searching…';
      try{if(!records){pending??=fetch('/search-index.json').then(async r=>{if(!r.ok)throw Error();records=indexSearch(await r.json() as SearchRecord[]);}).finally(()=>{pending=undefined});await pending;}if(current!==revision)return;const found=searchRecords(records!,raw,section.value);status.textContent=`${found.length} result${found.length===1?'':'s'}${found.length>100?' · showing the first 100':''}`;
        for(const r of found.slice(0,100)){const article=document.createElement('article');article.className='search-result';const label=document.createElement('span');label.className='eyebrow';label.textContent=r.sectionLabel;const h=document.createElement('h2');const a=document.createElement('a');a.href=r.url;a.textContent=r.title;h.append(a);const p=document.createElement('p');const lower=r.text.toLowerCase(),at=lower.indexOf(raw.toLowerCase());p.textContent=at>=0?`${at>60?'…':''}${r.text.slice(Math.max(0,at-60),at+190)}…`:r.summary;article.append(label,h,p);output.append(article);}if(!found.length){const p=document.createElement('p');p.textContent='No matches. Try fewer words or a different section.';output.append(p);}
      }catch{if(current!==revision)return;status.textContent='Search could not load. Your query is still here; try again.';retry.hidden=false;}}
    form.addEventListener('submit',e=>{e.preventDefault();void run()});form.addEventListener('input',()=>{clearTimeout(timer);timer=window.setTimeout(()=>void run(),120)});retry.addEventListener('click',()=>void run());if(input.value)void run();
  </script>
</BaseLayout>
