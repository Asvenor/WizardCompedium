---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---

<BaseLayout
  title="Search"
  description="Search every migrated chapter, heading, spell, build, German conversion, and reference page."
>
  <div class="site-shell search-shell">
    <p class="kicker">Full Compendium index</p>
    <h1>Search everything</h1>
    <p>
      Search chapter titles, headings, tables, tactical guidance, spells,
      builds, German conversion, and source rules.
    </p>
    <form class="compendium-search" role="search" data-compendium-search>
      <label for="compendium-search-input">Search the Compendium</label>
      <div class="search-input-wrap">
        <span aria-hidden="true">⌕</span>
        <input
          id="compendium-search-input"
          type="search"
          placeholder="Try a spell, rule, build, item, or problem…"
          autocomplete="off"
          spellcheck="false"
          autofocus
          data-search-input
        />
        <kbd aria-label="Ctrl+K on Windows or Command+K on Mac"
          >Ctrl+K / ⌘K</kbd
        >
      </div>
      <label class="field-label"
        ><span>Result category</span><select class="field" data-search-kind
          ><option value="">All results</option>{
            [
              'Spell',
              'Chapter',
              'Build',
              'Tool',
              'German Conversion',
              'Reference',
            ].map((kind) => <option>{kind}</option>)
          }</select
        ></label
      >
    </form>
    <p class="search-status" aria-live="polite" data-search-status>
      Loading the Compendium index…
    </p>
    <div class="search-recovery" data-search-recovery hidden>
      <button class="button" type="button" data-search-retry>Retry search</button>
      <a href="/compendium/">Browse chapters instead</a>
    </div>
    <p class="control-note">
      Showing the best 50 matches. Choose a category to narrow broad searches.
    </p>
    <div class="compendium-search-results" data-search-results></div>
    <script>
      import { indexDocuments, searchDocuments, normalizeQuery } from '@/features/search/index.mjs';
      interface SearchDocument {
        title: string;
        description: string;
        content: string;
        url: string;
        kind: string;
        meta: string;
      }

      const kind =
        document.querySelector<HTMLSelectElement>('[data-search-kind]');
      const input = document.querySelector<HTMLInputElement>(
        '[data-search-input]',
      );
      const status = document.querySelector<HTMLElement>(
        '[data-search-status]',
      );
      const results = document.querySelector<HTMLElement>(
        '[data-search-results]',
      );
      let documents: SearchDocument[] = [];
      let index: ReturnType<typeof indexDocuments> = [];
      let ready = false;
      let loading = false;
      const recovery = document.querySelector<HTMLElement>('[data-search-recovery]');
      const initial = new URLSearchParams(location.search);
      if (input) input.value = initial.get('q') ?? '';
      if (kind) kind.value = initial.get('kind') ?? '';

      const makeExcerpt = (document: SearchDocument, query: string) => {
        const source = document.content || document.description;
        const lowerSource = source.toLocaleLowerCase();
        const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
        const positions = terms
          .map((term) => lowerSource.indexOf(term))
          .filter((position) => position >= 0);
        const match = positions.length ? Math.min(...positions) : 0;
        const start = Math.max(0, match - 85);
        const end = Math.min(source.length, match + 190);
        return `${start > 0 ? '…' : ''}${source.slice(start, end).trim()}${end < source.length ? '…' : ''}`;
      };

      const renderResults = (query: string) => {
        if (!input || !status || !results || !ready) return;
        const normalizedQuery = normalizeQuery(query);
        results.replaceChildren();

        if (!normalizedQuery) {
          status.textContent = `Search ${documents.length} spells, chapters, builds, tools, and German terms.`;
          return;
        }

        const matches = searchDocuments(index, query, kind?.value ?? '');

        status.textContent = matches.length
          ? `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query.trim()}”.`
          : `No results for “${query.trim()}”. Try a shorter term or a different spelling.`;

        matches.slice(0, 50).forEach(({ document: entry }: { document: SearchDocument }) => {
          const article = document.createElement('article');
          article.className = 'search-result';

          const meta = document.createElement('p');
          meta.className = 'search-result-meta';
          meta.textContent = `${entry.kind} · ${entry.meta}`;

          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = entry.url;
          link.textContent = entry.title;
          heading.append(link);

          const excerpt = document.createElement('p');
          excerpt.className = 'search-result-excerpt';
          excerpt.textContent = makeExcerpt(entry, query.trim());

          article.append(meta, heading, excerpt);
          results.append(article);
        });
      };

      const loadIndex = async () => {
        if (!input || !status || !results || loading) return;
        loading = true;
        status.textContent = 'Loading the Compendium index…';
        if (recovery) recovery.hidden = true;
        const controller = new AbortController();
        const timeout = window.setTimeout(() => controller.abort(), 15000);
        try {
          const response = await fetch('/search-index.json', {signal: controller.signal});
          if (!response.ok)
            throw new Error(`Search index returned ${response.status}`);
          documents = await response.json();
          if (!Array.isArray(documents)) throw new Error('Invalid search index');
          index = indexDocuments(documents);
          ready = true;
          renderResults(input.value);
        } catch (error) {
          console.error(error);
          status.textContent =
            'Search could not load. Retry or browse the chapter directory; your query is kept.';
          if (recovery) recovery.hidden = false;
        } finally {
          window.clearTimeout(timeout);
          loading = false;
        }
      };
      document.querySelector('[data-search-retry]')?.addEventListener('click', loadIndex);

      input?.addEventListener('input', () => {
        const query = input.value;
        const url = new URL(window.location.href);
        query.trim()
          ? url.searchParams.set('q', query.trim())
          : url.searchParams.delete('q');
        window.history.replaceState({}, '', url);
        renderResults(query);
      });

      kind?.addEventListener('change', () => {
        const url = new URL(location.href);
        kind.value
          ? url.searchParams.set('kind', kind.value)
          : url.searchParams.delete('kind');
        history.replaceState({}, '', url);
        renderResults(input?.value ?? '');
      });
      window.addEventListener('popstate', () => {
        const p = new URLSearchParams(location.search);
        if (input) input.value = p.get('q') ?? '';
        if (kind) kind.value = p.get('kind') ?? '';
        renderResults(input?.value ?? '');
      });
      document
        .querySelector('[data-compendium-search]')
        ?.addEventListener('submit', (event) => event.preventDefault());
      loadIndex();
    </script>
    <noscript
      >Search requires JavaScript. Browse the <a href="/compendium/"
        >chapter directory</a
      >, <a href="/spells/">spell list</a>, or <a href="/reference/german/"
        >German lookup</a
      >.</noscript
    >
  </div>
</BaseLayout>
