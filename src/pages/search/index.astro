---
import BaseLayout from '@/components/layout/BaseLayout.astro';
---
<BaseLayout title="Search" description="Search every migrated chapter, heading, spell, build, German conversion, and reference page.">
  <div class="site-shell search-shell">
    <p class="kicker">Full Compendium index</p>
    <h1>Search everything</h1>
    <p>Search chapter titles, headings, tables, tactical guidance, spells, builds, German conversion, and source rules.</p>
    <form class="compendium-search" role="search" data-compendium-search>
      <label for="compendium-search-input">Search the Compendium</label>
      <div class="search-input-wrap">
        <span aria-hidden="true">⌕</span>
        <input
          id="compendium-search-input"
          type="search"
          placeholder="Try a spell, rule, build, item, or problem…"
          autocomplete="off"
          spellcheck="false"
          autofocus
          data-search-input
        />
        <kbd aria-label="Keyboard shortcut">⌘ K</kbd>
      </div>
    </form>
    <p class="search-status" aria-live="polite" data-search-status>Loading the Compendium index…</p>
    <div class="compendium-search-results" data-search-results></div>
    <script>
      interface SearchDocument {
        title: string;
        description: string;
        content: string;
        url: string;
        kind: string;
        meta: string;
      }

      const input = document.querySelector<HTMLInputElement>('[data-search-input]');
      const status = document.querySelector<HTMLElement>('[data-search-status]');
      const results = document.querySelector<HTMLElement>('[data-search-results]');
      let documents: SearchDocument[] = [];

      const normalize = (value: string) => value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLocaleLowerCase()
        .replace(/[^a-z0-9+]+/g, ' ')
        .trim();

      const makeExcerpt = (document: SearchDocument, query: string) => {
        const source = `${document.description} ${document.content}`.trim();
        const lowerSource = source.toLocaleLowerCase();
        const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
        const positions = terms.map((term) => lowerSource.indexOf(term)).filter((position) => position >= 0);
        const match = positions.length ? Math.min(...positions) : 0;
        const start = Math.max(0, match - 85);
        const end = Math.min(source.length, match + 190);
        return `${start > 0 ? '…' : ''}${source.slice(start, end).trim()}${end < source.length ? '…' : ''}`;
      };

      const renderResults = (query: string) => {
        if (!input || !status || !results) return;
        const normalizedQuery = normalize(query);
        results.replaceChildren();

        if (!normalizedQuery) {
          status.textContent = `Search ${documents.length} chapters, references, and spells.`;
          return;
        }

        const terms = normalizedQuery.split(' ').filter(Boolean);
        const matches = documents.map((document) => {
          const title = normalize(document.title);
          const description = normalize(document.description);
          const content = normalize(document.content);
          const haystack = `${title} ${description} ${content}`;
          if (!terms.every((term) => haystack.includes(term))) return null;

          let score = 0;
          if (title === normalizedQuery) score += 300;
          else if (title.includes(normalizedQuery)) score += 180;
          score += terms.filter((term) => title.includes(term)).length * 45;
          score += terms.filter((term) => description.includes(term)).length * 18;
          score += terms.filter((term) => content.includes(term)).length * 4;
          if (document.kind === 'Spell') score += 3;
          return { document, score };
        }).filter((match): match is { document: SearchDocument; score: number } => Boolean(match))
          .sort((a, b) => b.score - a.score || a.document.title.localeCompare(b.document.title))
          .slice(0, 30);

        status.textContent = matches.length
          ? `${matches.length}${matches.length === 30 ? '+' : ''} result${matches.length === 1 ? '' : 's'} for “${query.trim()}”.`
          : `No results for “${query.trim()}”. Try a shorter term or a different spelling.`;

        matches.forEach(({ document: entry }) => {
          const article = document.createElement('article');
          article.className = 'search-result';

          const meta = document.createElement('p');
          meta.className = 'search-result-meta';
          meta.textContent = `${entry.kind} · ${entry.meta}`;

          const heading = document.createElement('h2');
          const link = document.createElement('a');
          link.href = entry.url;
          link.textContent = entry.title;
          heading.append(link);

          const excerpt = document.createElement('p');
          excerpt.className = 'search-result-excerpt';
          excerpt.textContent = makeExcerpt(entry, query.trim());

          article.append(meta, heading, excerpt);
          results.append(article);
        });
      };

      const loadIndex = async () => {
        if (!input || !status || !results) return;
        try {
          const response = await fetch('/search-index.json');
          if (!response.ok) throw new Error(`Search index returned ${response.status}`);
          documents = await response.json();
          const query = new URLSearchParams(window.location.search).get('q') ?? '';
          input.value = query;
          renderResults(query);
        } catch (error) {
          console.error(error);
          status.textContent = 'Search could not load. Please refresh the page or browse the chapter directory.';
        }
      };

      input?.addEventListener('input', () => {
        const query = input.value;
        const url = new URL(window.location.href);
        query.trim() ? url.searchParams.set('q', query.trim()) : url.searchParams.delete('q');
        window.history.replaceState({}, '', url);
        renderResults(query);
      });

      document.querySelector('[data-compendium-search]')?.addEventListener('submit', (event) => event.preventDefault());
      loadIndex();
    </script>
    <noscript>Search requires JavaScript. You can still browse all chapters from the Reference hub.</noscript>
  </div>
</BaseLayout>
