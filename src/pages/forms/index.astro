---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Catalog from '@/components/Catalog.astro';
import {hrefFor} from '@/lib/vault';
---
<BaseLayout title="Form finder" active="library" wide><div class="page-shell"><header class="page-header"><p class="eyebrow">CREATURES, MINIONS &amp; FORMS</p><h1>Choose the right form.</h1><p>Find transformation, familiar, and binding candidates. A candidate flag checks the stat block; the spell’s other requirements still apply.</p><div class="toolbar"><a class="button" href={hrefFor('Form Legality Guide')}>Check form legality</a><a class="button" href={hrefFor('000 Minion Management')}>Manage your minions</a><a href={hrefFor('Polymorph Friendly&Hostile Tier List')}>Form priorities →</a></div></header><Catalog kind="forms"/></div></BaseLayout>
