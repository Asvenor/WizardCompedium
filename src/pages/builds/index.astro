---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import {getNotes,findNote,hrefFor,noteHref} from '@/lib/vault';
const subclasses=['Abjurer','Bladesinger','Chronurgy','Conjurer','Diviner','Illusionist','Necromancer'];
const structures=[['','Pure Wizard'],['Artificer','Artificer 1'],['Cleric','Cleric 1'],['Fighter 1','Fighter 1'],['Fighter 2','Fighter 2']];
const progressions=getNotes().filter(n=>n.sourcePath.includes('/Spell Progressions/'));
const getRoute=(subclass:string,prefix:string)=>findNote(`${prefix?prefix+' ':''}${subclass} - Spell Progression`);
---
<BaseLayout title="Wizard builds & progressions" active="builds" wide><div class="page-shell"><header class="page-header"><p class="eyebrow">BUILD WITH INTENT</p><h1>Seven subclasses. Your route.</h1><p>Compare the pure Wizard and multiclass paths, then follow a complete spell progression. Each route separates normal acquisitions, Savant additions, and always-prepared spells.</p><div class="toolbar"><a class="button button--primary" href="/level-up/">Check my level &amp; spell counts</a><a class="button" href={hrefFor('Build Decision Engine')}>Choose your build</a><a class="button" href={hrefFor('Subclasses')}>Subclass features</a><a href={hrefFor('Level Progression Planner')}>Understand the timing tradeoffs →</a></div></header>
  <section aria-labelledby="progression-title"><div class="section-heading"><h2 id="progression-title">Spell progressions</h2><p>Each guide is a complete path with no copying or found spellbooks assumed.</p></div><div class="data-table table-wrap" tabindex="0" role="region" aria-label="Subclass and class structure progressions"><table class="directory-table build-matrix"><thead><tr><th scope="col">Subclass</th>{structures.map(([,title])=><th scope="col">{title}</th>)}</tr></thead><tbody>{subclasses.map(sub=><tr><th scope="row">{sub}</th>{structures.map(([prefix,label])=>{const n=getRoute(sub,prefix);return <td data-label={label}>{n?<a href={noteHref(n)} aria-label={`${sub}: ${label} progression`}>Level-by-level guide <span aria-hidden="true">↗</span></a>:<span>Guide unavailable</span>}</td>})}</tr>)}</tbody></table></div><p class="control-note">{progressions.length-1} core routes · <a href={hrefFor('Illusion Adept - Spell Progression')}>Optional Illusion Adept configuration</a></p></section>
  <section class="section"><h2>Make the choice work at the table.</h2><div class="library-grid">{['Character','Arcana Unleashed Builds','Worked Wizard Builds','Prepared Loadouts','Spell Progression Hub','Equipment'].map(name=>{const n=findNote(name);return n&&<article class="note-card"><p class="eyebrow">BUILD REFERENCE</p><h3><a href={noteHref(n)}>{n.title}</a></h3><p>{n.summary}</p></article>})}</div></section>
</div></BaseLayout>
