---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';

const spells = (await getCollection('spells')).map((entry) => entry.data)
  .sort((a, b) => a.level - b.level || a.name.localeCompare(b.name));
---
<BaseLayout title="My Wizard" description="A local-only Wizard profile for Compendium tools.">
  <header class="page-hero"><div class="site-shell"><p class="kicker">Stored only in this browser</p><h1>My Wizard</h1><p>Save the small amount of character information used by the level-up and prepared-spell tools. No account or cloud storage is involved.</p></div></header>
  <section class="section section--first">
    <div class="site-shell wizard-profile-layout">
      <form class="tool-panel wizard-profile-form" data-wizard-profile-form>
        <div class="tool-panel-head"><div><p class="eyebrow">Local profile</p><h2>Edit Wizard</h2></div><span class="local-badge">Local only</span></div>
        <div class="form-grid">
          <label class="field-label field-span-2"><span>Character name <small>optional</small></span><input class="field" name="name" autocomplete="off" /></label>
          <label class="field-label"><span>Build</span><select class="field" name="build">{['CORE','CHRON','DIV','ILL','BLADE','TANK','FIGHTER'].map((build) => <option value={build}>{build}</option>)}</select></label>
          <label class="field-label"><span>Character level</span><input class="field" name="characterLevel" type="number" min="1" max="20" value="2" /></label>
          <label class="field-label"><span>Wizard level</span><input class="field" name="wizardLevel" type="number" min="0" max="20" value="1" /></label>
          <label class="field-label"><span>Intelligence</span><input class="field" name="intelligence" type="number" min="1" max="30" /></label>
          <label class="field-label"><span>Spell Save DC</span><input class="field" name="spellSaveDc" type="number" min="1" max="40" /></label>
          <label class="field-label"><span>Spell Attack Bonus</span><input class="field" name="spellAttackBonus" type="number" min="-5" max="30" /></label>
          <label class="field-label field-span-2"><span>Known / owned spells <small>optional · use Command/Ctrl to select several</small></span><select class="field multi-select" name="ownedSpells" multiple size="10">{spells.map((spell) => <option value={spell.id}>{spell.level === 0 ? 'Cantrip' : `L${spell.level}`} · {spell.name}</option>)}</select></label>
          <label class="field-label field-span-2"><span>Prepared spells <small>optional</small></span><select class="field multi-select" name="preparedSpells" multiple size="10">{spells.map((spell) => <option value={spell.id}>{spell.level === 0 ? 'Cantrip' : `L${spell.level}`} · {spell.name}</option>)}</select></label>
        </div>
        <div class="form-actions"><button class="button button--primary" type="submit">Save Wizard</button><button class="button button--danger" type="button" data-reset-wizard>Reset Wizard</button><span class="save-status" aria-live="polite" data-profile-status></span></div>
      </form>
      <aside class="wizard-tool-links">
        <p class="eyebrow">Use this profile</p>
        <a href="/wizard/level-up/"><strong>Level-Up Assistant</strong><span>See the next roadmap milestone →</span></a>
        <a href="/prepare/"><strong>Prepared Spell Planner</strong><span>Build a mission package →</span></a>
        <a href="/tools/"><strong>Calculators</strong><span>Use your saved DC and save bonus →</span></a>
        <p>The rest of the Compendium works normally when no profile exists.</p>
      </aside>
    </div>
  </section>
  <script>
    import { defaultWizardProfile, loadWizardProfile, resetWizardProfile, saveWizardProfile, type WizardProfile } from '@/features/my-wizard/profile';
    const form = document.querySelector<HTMLFormElement>('[data-wizard-profile-form]');
    const status = document.querySelector<HTMLElement>('[data-profile-status]');
    if (form) {
      const numberOrNull = (data: FormData, key: string) => {
        const value = String(data.get(key) ?? '').trim();
        return value === '' ? null : Number(value);
      };
      const setForm = (profile: WizardProfile) => {
        (form.elements.namedItem('name') as HTMLInputElement).value = profile.name;
        (form.elements.namedItem('build') as HTMLSelectElement).value = profile.build;
        (form.elements.namedItem('characterLevel') as HTMLInputElement).value = String(profile.characterLevel);
        (form.elements.namedItem('wizardLevel') as HTMLInputElement).value = String(profile.wizardLevel);
        (form.elements.namedItem('intelligence') as HTMLInputElement).value = profile.intelligence == null ? '' : String(profile.intelligence);
        (form.elements.namedItem('spellSaveDc') as HTMLInputElement).value = profile.spellSaveDc == null ? '' : String(profile.spellSaveDc);
        (form.elements.namedItem('spellAttackBonus') as HTMLInputElement).value = profile.spellAttackBonus == null ? '' : String(profile.spellAttackBonus);
        const owned = new Set(profile.ownedSpells);
        const prepared = new Set(profile.preparedSpells);
        [...(form.elements.namedItem('ownedSpells') as HTMLSelectElement).options].forEach((option) => { option.selected = owned.has(option.value); });
        [...(form.elements.namedItem('preparedSpells') as HTMLSelectElement).options].forEach((option) => { option.selected = prepared.has(option.value); });
      };
      setForm(loadWizardProfile() ?? defaultWizardProfile());
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const data = new FormData(form);
        const profile: WizardProfile = {
          name: String(data.get('name') ?? '').trim(),
          build: String(data.get('build') ?? 'CORE') as WizardProfile['build'],
          characterLevel: Number(data.get('characterLevel') ?? 1),
          wizardLevel: Number(data.get('wizardLevel') ?? 1),
          intelligence: numberOrNull(data, 'intelligence'),
          spellSaveDc: numberOrNull(data, 'spellSaveDc'),
          spellAttackBonus: numberOrNull(data, 'spellAttackBonus'),
          ownedSpells: data.getAll('ownedSpells').map(String),
          preparedSpells: data.getAll('preparedSpells').map(String),
        };
        saveWizardProfile(profile);
        if (status) status.textContent = 'Saved in this browser.';
      });
      form.querySelector('[data-reset-wizard]')?.addEventListener('click', () => {
        if (!window.confirm('Reset the Wizard profile stored in this browser?')) return;
        resetWizardProfile();
        setForm(defaultWizardProfile());
        if (status) status.textContent = 'Local profile reset.';
      });
    }
  </script>
</BaseLayout>
