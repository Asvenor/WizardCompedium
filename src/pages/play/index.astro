---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import {findNote,noteHref} from '@/lib/vault';
---
<BaseLayout title="At the table" active="play"><div class="page-shell"><header class="page-header"><p class="eyebrow">WHEN THE DICE COME OUT</p><h1>Less searching. More playing.</h1><p>Open a combat reference, check a rule, or update your PDF sheet between sessions.</p></header><div class="library-grid">{['Combat Dashboard','Reaction Management','Concentration','Prepared Loadouts','Rules Desk','Problem Navigator'].map(name=>{const n=findNote(name);return n&&<article class="note-card"><p class="eyebrow">QUICK REFERENCE</p><h2><a href={noteHref(n)}>{n.title}</a></h2><p>{n.summary}</p></article>})}<article class="note-card"><p class="eyebrow">YOUR CHARACTER SHEET</p><h2><a href="/play/import/">Open your PDF</a></h2><p>Edit your sheet, save it in this browser, and export an updated PDF for the next session.</p></article><article class="note-card"><p class="eyebrow">YOUR SHORTLIST</p><h2><a href="/library/?saved=1">Saved references</a></h2><p>The pages you’ve saved for quick access on this device.</p></article></div></div></BaseLayout>
