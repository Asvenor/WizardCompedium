---
import { getCollection } from 'astro:content';
import { extractTableRows } from '@/lib/compendium-tables';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProblemNavigator from '@/components/ProblemNavigator.astro';
import { playCards } from '@/data/play-mode';
const chapter = (await getCollection('chapters')).find(
  (c) => c.data.chapter === 18,
)!;
const decisions = extractTableRows(chapter.body ?? '', 0).slice(1);
const modules = [
  ['Reaction', '/quick/reactions/'],
  ['Concentration', '/play/concentration/'],
  ['Target defense', '/quick/targeting/'],
  ['Legendary Resistance', '/play/boss/'],
  ['Enemy caster', '/quick/anti-caster/'],
  ['Positioning / counterplay', '/quick/anti-wizard/'],
  ['Ally rescue / escape', '/quick/emergency/'],
  ['Objective', '/quick/objectives/'],
  ['Exploration', '/quick/exploration/'],
  ['Party handoffs', '/quick/party/'],
  ['Resources', '/wizard/resources/'],
  ['Spell lookup', '/spells/'],
];
---

<BaseLayout
  title="Play Mode"
  description="Fast Wizard decisions during actual play, linked to the complete Compendium."
  active="play"
>
  <header class="page-hero play-hero">
    <div class="site-shell">
      <p class="kicker">At the table</p><h1>Play Mode</h1><p>
        Choose the pressure in front of you. Open the quick reference only when
        needed, then follow the source link for the full rule or playbook.
      </p>
    </div>
  </header>
  <section class="section section--first">
    <div class="site-shell">
      <nav class="form-actions" aria-label="Play modules">
        {
          modules.map(([title, url]) => (
            <a class="button" href={url}>
              {title}
            </a>
          ))
        }
      </nav>
      <article class="tool-panel" id="turn-decision">
        <h2>What needs to change this turn?</h2><p>
          Use the Chapter 18 decision questions. This aid cannot see the
          battlefield or choose a perfect turn.
        </p><label class="field-label"
          ><span>Current decision</span><select class="field" data-turn-question
            >{
              decisions.map((row, i) => <option value={i}>{row[0]}</option>)
            }</select
          ></label
        ><div class="reference-card-grid">
          {
            decisions.map((row, i) => (
              <section data-turn-answer={i}>
                <>
                  <h3>{row[0]}</h3>
                  <p>
                    <strong>If yes:</strong> {row[1]}
                  </p>
                  <p>
                    <strong>If no:</strong> {row[2]}
                  </p>
                </>
              </section>
            ))
          }
        </div><p>
          Before spending: is your concentration already winning, does the
          target resist this defense, and can your party convert the result?
        </p><a href="/chapters/18-combat-decision-engine/"
          >Full Combat Decision Engine →</a
        >
      </article>
      <div class="form-actions">
        <a href="/spells/?action=reaction&personal=prepared"
          >My prepared reactions</a
        ><a href="/quick/reactions/">All reaction conflicts</a><a
          href="/wizard/resources/">My first-turn plan</a
        >
      </div>
      <div class="play-card-grid">
        {
          playCards.map((card) => (
            <article class="play-card" id={card.id}>
              <p class="eyebrow">{card.label}</p>
              <h2>{card.fast}</h2>
              <details>
                <summary>Quick reference</summary>
                <ul>
                  {card.quick.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </details>
              <a href={card.href}>{card.linkLabel} →</a>
            </article>
          ))
        }
        <article class="play-card play-card--lookup" id="spell-lookup">
          <p class="eyebrow">Spell lookup</p>
          <h2>Jump directly to a spell, role, rule, or tactical phrase.</h2>
          <form action="/search/" method="get" role="search">
            <label class="sr-only" for="play-search"
              >Search the Compendium</label
            >
            <input
              class="field"
              id="play-search"
              name="q"
              type="search"
              placeholder="Wall of Force, concentration…"
            />
            <button class="button button--primary" type="submit">Search</button>
          </form>
          <a href="/spells/">Open Spell Database →</a>
        </article>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="site-shell">
      <div class="section-head">
        <div>
          <p class="kicker">Problem Navigator</p><h2>
            Need a different answer?
          </h2>
        </div><a class="section-link" href="/problems/">Open full navigator →</a
        >
      </div>
      <ProblemNavigator compact />
    </div>
  </section>
  <script>
    const select = document.querySelector<HTMLSelectElement>(
      '[data-turn-question]',
    )!;
    const cards = [
      ...document.querySelectorAll<HTMLElement>('[data-turn-answer]'),
    ];
    const update = () =>
      cards.forEach((c) => (c.hidden = c.dataset.turnAnswer !== select.value));
    select.addEventListener('change', update);
    update();
  </script>
</BaseLayout>
