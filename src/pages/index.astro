---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProblemNavigator from '@/components/ProblemNavigator.astro';

const primaryActions = [
  { label: 'Combat', detail: 'Choose the job, target, and fallback.', href: '/play/#combat-decision', tone: 'violet' },
  { label: 'Prepare spells', detail: 'Build today’s mission package.', href: '/prepare/', tone: 'blue' },
  { label: 'Level up', detail: 'See the next milestone and audit.', href: '/wizard/level-up/', tone: 'orange' },
  { label: 'Find a spell', detail: 'Filter the canonical spell database.', href: '/spells/', tone: 'green' },
  { label: 'Boss fight', detail: 'Plan around layered defenses.', href: '/play/#boss-fight', tone: 'pink' },
  { label: 'Emergency', detail: 'Stabilize, extract, and preserve the objective.', href: '/play/#escape', tone: 'red' },
];

const secondaryActions = [
  { label: 'Exploration', href: '/play/#exploration' },
  { label: 'Builds', href: '/builds/' },
  { label: 'Spell comparison', href: '/spells/compare/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Full Compendium', href: '/compendium/' },
  { label: 'Search', href: '/search/' },
];
---
<BaseLayout title="Wizard Compendium" description="Ultimate Min-Max Reference">
  <section class="cockpit-hero">
    <div class="site-shell cockpit-hero-grid">
      <div>
        <p class="kicker">Wizard optimization operating system</p>
        <h1>What do you need right now?</h1>
        <p>Start with the decision in front of you. Every fast answer leads back to the complete Compendium.</p>
      </div>
      <aside class="wizard-status-card">
        <span class="status-dot" aria-hidden="true"></span>
        <div><strong>Session cockpit ready</strong><p>Profile is optional. The complete reference works without setup.</p></div>
        <a href="/wizard/">My Wizard →</a>
      </aside>
    </div>
  </section>

  <section class="section cockpit-section">
    <div class="site-shell">
      <div class="cockpit-action-grid">
        {primaryActions.map((action, index) => (
          <a class={`cockpit-action cockpit-action--${action.tone}`} href={action.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{action.label}</h2>
            <p>{action.detail}</p>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
      <div class="cockpit-shortcuts" aria-label="More Compendium tools">
        {secondaryActions.map((action) => <a href={action.href}>{action.label}<span aria-hidden="true">↗</span></a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="site-shell">
      <div class="section-head">
        <div><p class="kicker">Problem Navigator</p><h2>Start with the table problem</h2></div>
        <a class="section-link" href="/problems/">Open the full navigator →</a>
      </div>
      <ProblemNavigator compact />
    </div>
  </section>

  <section class="section full-compendium-strip">
    <div class="site-shell full-compendium-strip-inner">
      <div><p class="kicker">Level 3 · Deep reference</p><h2>Nothing has been removed.</h2><p>Browse all 61 chapters, the German conversion, source rules, and every reference table.</p></div>
      <a class="button button--primary" href="/compendium/">Open Full Compendium</a>
    </div>
  </section>
</BaseLayout>
