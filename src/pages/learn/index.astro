---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { corePrinciples } from '@/data/core-principles';
import { getSpellRoleCategories } from '@/lib/spells';
import { getBuilds } from '@/lib/builds';
import { extractTableRows } from '@/lib/compendium-tables';
const chapters = await getCollection('chapters');
const spells = (await getCollection('spells'))
  .map((e) => e.data)
  .filter(
    (s) =>
      s.compendium.summary &&
      !s.compendium.summary.startsWith(
        'The Compendium includes this spell in its maintained spellbook pool',
      ),
  );
const cards = [
  ...corePrinciples.map((p, i) => ({
    id: 'principle-' + i,
    deck: 'Core principles',
    question: p.question,
    answer: p.answer,
    href: p.href,
  })),
  ...spells.map((s) => ({
    id: 'spell-' + s.id,
    deck: 'Spell roles',
    level: s.level,
    source: s.source.category,
    categories: getSpellRoleCategories(s),
    question: s.name + ' — what job does it do?',
    answer:
      s.compendium.summary +
      (s.compendium.roles.length
        ? ' Roles: ' + s.compendium.roles.join(', ')
        : ''),
    href: `/spells/${s.id}/`,
  })),
  ...(await getBuilds()).map((b) => ({
    id: 'build-' + b.id,
    deck: 'Builds',
    question: b.id + ' — when does this route fit, and what does it cost?',
    answer: b.fit + ' ' + b.caution,
    href: b.href,
  })),
  ...[
    { chapter: 45, table: 2, deck: 'Reactions' },
    { chapter: 59, table: 1, deck: 'Targeting' },
    { chapter: 18, table: 0, deck: 'Tactics' },
  ].flatMap((group) => {
    const source = chapters.find((c) => c.data.chapter === group.chapter)!;
    const rows = extractTableRows(source.body ?? '', group.table);
    return rows.slice(1).map((row, i) => ({
      id: `reference-${group.chapter}-${i}`,
      deck: group.deck,
      question: row[0] + ' — what is the Compendium guidance?',
      answer: row
        .slice(1)
        .map((value, j) => rows[0][j + 1] + ': ' + value)
        .join(' '),
      href: `/chapters/${source.id}/`,
    }));
  }),
];
---

<BaseLayout title="Learning Mode" active="learn"
  ><header class="page-hero">
    <div class="site-shell">
      <p class="kicker">Recall before lookup</p><h1>Learning Mode</h1><p>
        Short source-derived questions for the decisions you make repeatedly.
        Review history stays in this browser.
      </p><a href="/learn/priorities/">What should I memorize? →</a>
    </div>
  </header><section class="section section--first">
    <div class="site-shell learning-layout">
      <article class="tool-panel" data-practice>
        <h2>Practice</h2><label class="field-label"
          ><span>Practice deck</span><select class="field" data-practice-deck
            ><option value="">All topics</option>{
              [...new Set(cards.map((c) => c.deck))].map((deck) => (
                <option>{deck}</option>
              ))
            }<optgroup label="Spell decks"
              ><option value="core-spells">Core spells</option><option
                value="dunamancy-spells">Dunamancy spells</option
              ><option value="control-spells">Control spells</option><option
                value="defense-spells">Defense spells</option
              >{
                Array.from({ length: 10 }, (_, level) => (
                  <option value={`level-${level}`}>
                    {level === 0 ? 'Cantrips' : `Level ${level} spells`}
                  </option>
                ))
              }</optgroup
            ></select
          ></label
        ><p data-practice-progress role="status"></p><div class="flashcard">
          <h3 data-practice-question>
            Choose a deck and recall the answer before revealing it.
          </h3><div data-practice-answer hidden>
            <p data-practice-copy></p><a data-practice-source>Full source →</a>
          </div>
        </div><div class="form-actions">
          <button
            class="button button--primary"
            type="button"
            data-practice-reveal>Reveal answer</button
          ><button
            class="button"
            type="button"
            data-practice-grade="correct"
            disabled>Got it</button
          ><button
            class="button"
            type="button"
            data-practice-grade="incorrect"
            disabled>Review again</button
          ><button class="button" type="button" data-practice-next>Skip</button>
        </div><p data-practice-history></p><p class="control-note">
          Unseen cards come first, then missed and least-recently reviewed
          cards. Self-assessment is not a rules test.
        </p>
      </article><article>
        <h2>Core principles · always available</h2>{
          corePrinciples.map((p) => (
            <details class="principle-card">
              <>
                <summary>{p.question}</summary>
                <div>
                  <>
                    <p>{p.answer}</p>
                    <a href={p.href}>{p.source} →</a>
                  </>
                </div>
              </>
            </details>
          ))
        }<noscript
          >Interactive practice needs JavaScript; the source principles and full
          Compendium remain available.</noscript
        >
      </article>
    </div>
  </section><script
    is:inline
    type="application/json"
    id="practice-cards"
    set:html={JSON.stringify(cards).replace(/</g, '\\u003c')}
  /><script>
    import '@/features/learning/practice';
  </script></BaseLayout
>
