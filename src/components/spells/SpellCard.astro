---
import { buildLabel, getSpellActionType, getSpellRoleCategories, getTierGroup } from '@/lib/spells';
interface Props { spell: any; }
const { spell } = Astro.props;
const levelLabel = spell.level === 0 ? 'Cantrip' : `Level ${spell.level}`;
const roleCategories = getSpellRoleCategories(spell);
const buildRelevance = spell.compendium.buildRelevance.map(buildLabel);
---
<a
  class="spell-card"
  href={`/spells/${spell.id}/`}
  data-spell-card
  data-search={`${spell.name} ${spell.compendium.summary} ${spell.compendium.roles.join(' ')} ${spell.source.category} ${buildRelevance.join(' ')}`.toLowerCase()}
  data-level={spell.level}
  data-role={spell.compendium.acquisitionRole}
  data-role-category={roleCategories.join(' ')}
  data-tier={getTierGroup(spell.compendium.tier)}
  data-concentration={String(spell.rules.concentration)}
  data-ritual={String(spell.rules.ritual)}
  data-save={(spell.rules.save.ability ?? 'none').toLowerCase()}
  data-attack={spell.rules.attackRoll ? 'spell-attack' : 'no-attack'}
  data-action={`${getSpellActionType(spell)}${spell.rules.ritual ? ' long-cast' : ''}`.trim()}
  data-damage={spell.rules.damageTypes.map((type: string) => type.toLowerCase()).join(' ')}
  data-build={buildRelevance.map((build: string) => build.toLowerCase()).join(' ')}
  data-source={spell.source.category}
>
  <div class="spell-card-head">
    <h2>{spell.name}</h2>
    <span class="badge">{levelLabel}</span>
  </div>
  <p>{spell.compendium.summary}</p>
  <div class="spell-tags">
    {spell.compendium.tier && <span class="badge" data-tier={getTierGroup(spell.compendium.tier).replace('-f', '')}>{spell.compendium.tier}</span>}
    <span class={`badge badge--${spell.compendium.acquisitionRole}`}>{spell.compendium.acquisitionRole}</span>
    {spell.rules.concentration && <span class="badge badge--concentration">Concentration</span>}
    {spell.rules.ritual && <span class="badge badge--ritual">Ritual</span>}
    {spell.source.sourceSensitive && <span class="badge">Source check</span>}
  </div>
</a>
