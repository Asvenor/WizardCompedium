---
import BaseLayout from './BaseLayout.astro';
import type { MarkdownHeading } from 'astro';
import chapterIndex from '@/data/chapters.json';

interface Props {
  title: string;
  description: string;
  chapter: number | null;
  part: string;
  hub: string;
  slug: string;
  headings?: MarkdownHeading[];
}
const { title, description, chapter, part, hub, slug, headings = [] } = Astro.props;
const hubLabels: Record<string, string> = {
  fundamentals: 'Fundamentals', builds: 'Builds', spells: 'Spells', combat: 'Combat & Tactics', gear: 'Gear & Operations', reference: 'Reference',
};
const siblings = chapterIndex.filter((item) => item.part === part);
---
<BaseLayout title={title} description={description} active={hub}>
  <div class="site-shell docs-grid">
    <nav class="side-nav" aria-label={`${part} chapters`}>
      <h2>{part}</h2>
      {siblings.map((item) => <a href={`/chapters/${item.slug}/`} aria-current={item.slug === slug ? 'page' : undefined}>Ch. {item.number} · {item.title}</a>)}
    </nav>
    <article class="article" data-pagefind-body>
      <div class="breadcrumbs">
        <a href="/">Home</a><span aria-hidden="true">/</span>
        <a href={`/${hub === 'fundamentals' ? 'reference' : hub}/`}>{hubLabels[hub]}</a><span aria-hidden="true">/</span>
        <span>{chapter == null ? title : `Chapter ${chapter}`}</span>
      </div>
      <header class="article-header">
        <div class="page-meta">
          {chapter != null && <span class="meta-pill">Chapter {chapter}</span>}
          <span class="meta-pill">{part}</span>
        </div>
        <h1 data-pagefind-meta="title">{title}</h1>
        <p>{description}</p>
      </header>
      <div class="prose"><slot /></div>
    </article>
    <nav class="toc" aria-label="On this page">
      <h2>On this page</h2>
      {headings.filter((heading) => heading.depth <= 3).map((heading) => <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>)}
    </nav>
  </div>
  <script>
    const tierColumnPattern = /\b(tier|priority|rank|rating)\b/i;
    const tierValuePattern = /^\s*([SABCDEF][+−-]?)(?=\s|\/|\*|$)/i;
    const conditionalRankPattern = /^(Niche|Campaign patch|Varies|Source check|Strategic|Mandatory)$/i;

    document.querySelectorAll<HTMLTableElement>('.prose table').forEach((table) => {
      const headers = [...table.querySelectorAll<HTMLTableCellElement>('thead th')];
      headers.forEach((header, index) => {
        if (!tierColumnPattern.test(header.textContent ?? '')) return;
        table.querySelectorAll<HTMLTableRowElement>('tbody tr').forEach((row) => {
          const cell = row.cells.item(index);
          if (!cell || cell.colSpan > 1) return;
          const value = cell.textContent?.trim() ?? '';
          const match = value.match(tierValuePattern);
          if (!match) {
            if (/^LOW$/i.test(value)) cell.dataset.tier = 'd';
            else if (conditionalRankPattern.test(value)) {
              cell.dataset.tier = 'conditional';
              cell.title = 'The Compendium gives this conditional label instead of a fixed letter rank.';
            }
            return;
          }
          const leadingTier = match[1].toLowerCase().charAt(0);
          cell.dataset.tier = ['e', 'f'].includes(leadingTier) ? 'd' : leadingTier;
        });
      });
    });
  </script>
</BaseLayout>
