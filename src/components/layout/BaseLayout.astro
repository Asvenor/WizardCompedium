---
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  active?: string;
}
const {
  title = 'Wizard Compendium',
  description = 'Ultimate min-max reference for Wizard builds, spells, tactics, gear, and campaign operations.',
  active = '',
} = Astro.props;
const pageTitle = title === 'Wizard Compendium' ? title : `${title} · Wizard Compendium`;
const nav = [
  ['Play', '/play/', 'play'],
  ['Builds', '/builds/', 'builds'],
  ['Spells', '/spells/', 'spells'],
  ['Tools', '/tools/', 'tools'],
  ['Learn', '/learn/', 'learn'],
  ['Compendium', '/compendium/', 'compendium'],
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>✦</text></svg>" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="brand" href="/" aria-label="Wizard Compendium home">
          <span class="brand-mark" aria-hidden="true"></span>
          <span>Wizard Compendium</span>
        </a>
        <nav class="global-nav" aria-label="Primary navigation">
          {nav.map(([label, href, key]) => <a href={href} aria-current={active === key ? 'page' : undefined}>{label}</a>)}
          <a class="nav-search" href="/search/">Search <span aria-hidden="true">⌘K</span></a>
        </nav>
        <a class="profile-link" href="/wizard/">My Wizard</a>
        <details class="mobile-nav">
          <summary>Menu</summary>
          <nav class="mobile-menu" aria-label="Mobile navigation">
            <a href="/">Home</a>
            {nav.map(([label, href]) => <a href={href}>{label}</a>)}
            <a href="/search/">Search</a>
            <a href="/wizard/">My Wizard</a>
          </nav>
        </details>
      </div>
    </header>
    <main class="site-main" id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <span>Ultimate Wizard Compendium · v1.14</span>
        <span>Rules text remains governed by the active source entry and campaign.</span>
      </div>
    </footer>
    <script is:inline>
      document.addEventListener('keydown', (event) => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          window.location.href = '/search/';
        }
      });
    </script>
  </body>
</html>
