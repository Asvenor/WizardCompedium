---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
  wide?: boolean;
  class?: string;
}

const {
  title,
  description = 'A working reference for Wizard builds, spells, tactics, magic items, and the decisions between sessions.',
  active = '',
  wide = false,
  class: pageClass = '',
} = Astro.props;
const navigation = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'questions', label: 'Answers', href: '/questions/' },
  { id: 'library', label: 'Library', href: '/library/' },
  { id: 'spells', label: 'Spells', href: '/spells/' },
  { id: 'builds', label: 'Builds', href: '/builds/' },
  { id: 'items', label: 'Items', href: '/items/' },
  { id: 'forms', label: 'Forms', href: '/forms/' },
  { id: 'tiers', label: 'Tier lists', href: '/tiers/' },
  { id: 'tools', label: 'Tools', href: '/tools/' },
  { id: 'play', label: 'At the table', href: '/play/' },
];
const currentSection = active === 'library' && Astro.url.pathname.startsWith('/items/') ? 'items'
  : active === 'library' && Astro.url.pathname.startsWith('/forms/') ? 'forms' : active;
const documentTitle = title === 'Wizard Compendium' ? title : `${title} · Wizard Compendium`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#262032" />
    <title>{documentTitle}</title>
    <slot name="head" />
  </head>
  <body class:list={[pageClass, { 'layout-wide': wide }]}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="site-brand" href="/" aria-label="Wizard Compendium home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="17" stroke="currentColor" stroke-width="1"/><path d="M20 5 23.5 16.5 35 20 23.5 23.5 20 35 16.5 23.5 5 20 16.5 16.5Z" stroke="currentColor" stroke-width="1.1"/><path d="m11 11 6 6M29 11l-6 6M29 29l-6-6M11 29l6-6" stroke="currentColor" stroke-width=".7"/><circle cx="20" cy="20" r="2" fill="currentColor"/></svg>
          </span>
          <span class="brand-name">Wizard <span>Compendium</span></span>
        </a>
        <nav class="primary-navigation" id="primary-navigation" aria-label="Main navigation" data-open="false">
          {navigation.map(item => <a href={item.href} aria-current={currentSection === item.id ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a href="/search/" class="search-trigger" aria-label="Search the compendium, Ctrl+K on Windows or Command+K on Mac">
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m12.5 12.5 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Search</span><kbd>Ctrl+K / ⌘K</kbd>
          </a>
          <button class="menu-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation">
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <span>Menu</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <div><span class="footer-brand">Wizard Compendium</span><p>A working reference for your next decision.</p></div>
        <nav aria-label="Footer navigation"><a href="/questions/">Quick answers</a><a href="/level-up/">Level up</a><a href="/library/">Browse the library</a><a href="/tools/">Tools</a><a href="/guide/">Website guide</a><a href="/search/">Search</a><a href="/play/import/">Your PDF sheet</a></nav>
      </div>
    </footer>
    <script>
      import {copyText} from '@/lib/share';
      document.documentElement.classList.add('has-js');
      const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      const setMenu = (open: boolean) => {
        if (!menu || !navigation) return;
        menu.setAttribute('aria-expanded', String(open));
        menu.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
        navigation.dataset.open = String(open);
      };
      menu?.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
      navigation?.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a')) setMenu(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') {
          setMenu(false);
          menu.focus();
        }
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k' && !event.altKey) {
          event.preventDefault();
          const input = document.querySelector<HTMLInputElement>('[data-search-input], #vault-search, #search-input');
          if (location.pathname.startsWith('/search/') && input) {
            input.focus();
            input.select();
          } else {
            location.assign('/search/');
          }
        }
      });
      const desktop = window.matchMedia('(min-width: 1200px)');
      desktop.addEventListener('change', () => setMenu(false));
      // Every reference section can be shared without guessing or copying an anchor.
      const reference=document.querySelector('[data-reference-content]');
      if(reference){
        const status=document.createElement('p');status.className='control-note section-share-status';status.setAttribute('role','status');
        reference.before(status);
        for(const heading of reference.querySelectorAll<HTMLElement>('h2[id],h3[id]')){
          const label=heading.textContent??'section';
          const link=document.createElement('a');link.className='section-permalink';link.href=`#${heading.id}`;link.textContent='#';link.setAttribute('aria-label',`Link to ${label}`);
          const copy=document.createElement('button');copy.type='button';copy.className='section-copy';copy.textContent='Copy link';copy.setAttribute('aria-label',`Copy link to ${label}`);
          copy.addEventListener('click',async()=>{const url=new URL(location.href);url.hash=heading.id;const ok=await copyText(url.href);status.textContent=ok?`Link to ${label} copied.`:`Copy is unavailable. Section link: ${url.href}`;});
          heading.append(link,copy);
        }
      }
      document.addEventListener('click',async(event)=>{
        const button=(event.target as Element).closest<HTMLButtonElement>('button[data-copy-url]');if(!button)return;
        const url=new URL(button.dataset.copyUrl||location.href,location.href);
        const ok=await copyText(url.href);
        const status=button.parentElement?.querySelector('[data-copy-status]');
        if(status)status.textContent=ok?`${button.dataset.copyLabel??'Link'} copied.`:`Copy is unavailable. Link: ${url.href}`;
      });
    </script>
  </body>
</html>
