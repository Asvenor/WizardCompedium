---
import {noteHref} from '@/lib/vault';
import {getFinderCatalog,catalogColumns,catalogValue,catalogFilters,catalogNotes,candidateRoutes,type CatalogKind} from '@/lib/catalog';
interface Props{kind:CatalogKind;}
const {kind}=Astro.props;
const notes=getFinderCatalog(kind),columns=catalogColumns[kind];
const options=(field:string)=>[...new Set(notes.flatMap(n=>{const v=n.metadata[field];return Array.isArray(v)?v:typeof v==='string'&&v?[v]:[]}))].sort((a,b)=>String(a).localeCompare(String(b)));
---
<section data-catalog={kind}>
  <form class="filter-bar catalog-filters" data-catalog-filters role="search">
    <label class="field-label"><span>Search {kind==='forms'?'forms':kind}</span><input class="field" type="search" name="q" placeholder={kind==='spells'?'Name, role, access…':kind==='forms'?'Name, role, senses…':'Name or role…'}/></label>
    {kind==='spells'&&<><label class="field-label"><span>Level</span><select class="field" name="level"><option value="">Any level</option>{Array.from({length:10},(_,i)=><option value={i}>{i===0?'Cantrip':`Level ${i}`}</option>)}</select></label><label class="field-label"><span>School</span><select class="field" name="school"><option value="">Any school</option>{options('school').map(v=><option>{v}</option>)}</select></label><label class="field-label"><span>Spell use</span><select class="field" name="focus"><option value="">Any spell use</option><option value="no-concentration">No concentration</option><option value="concentration">Concentration</option><option value="ritual">Ritual</option><option value="reaction">Reaction</option><option value="bonus-action">Bonus action</option></select></label></>}
    {kind==='items'&&<><label class="field-label"><span>Rarity</span><select class="field" name="rarity"><option value="">Any rarity</option>{options('rarity').map(v=><option>{v}</option>)}</select></label><label class="field-label"><span>Attunement</span><select class="field" name="attunement"><option value="">Any requirement</option><option value="false">No attunement</option><option value="true">Requires attunement</option></select></label></>}
    {kind==='forms'&&<><label class="field-label"><span>Candidate route</span><select class="field" name="route"><option value="">Any route</option>{candidateRoutes.map(([v,label])=><option value={v}>{label}</option>)}</select></label><label class="field-label"><span>Maximum CR</span><input class="field" type="number" name="maxcr" min="0" max="30" step="0.125" placeholder="Any CR" /></label><label class="field-label"><span>Movement</span><select class="field" name="movement"><option value="">Any movement</option>{['fly','swim','climb','burrow'].map(v=><option value={v}>{v[0].toUpperCase()+v.slice(1)}</option>)}</select></label></>}
    <details class="filter-more"><summary>More filters</summary><div class="filter-bar">
      {kind!=='forms'&&<label class="field-label"><span>Source</span><select class="field" name="source"><option value="">Any source</option>{options('source_group').map(v=><option>{v}</option>)}</select></label>}
      <label class="field-label"><span>Role</span><select class="field" name="role"><option value="">Any role</option>{options('roles').map(v=><option>{v}</option>)}</select></label>
      {kind==='forms'&&<><label class="field-label"><span>Senses</span><select class="field" name="senses"><option value="">Any senses</option>{['darkvision','blindsight','truesight','tremorsense'].map(v=><option value={v}>{v[0].toUpperCase()+v.slice(1)}</option>)}</select></label><label class="field-label"><span>Review status</span><select class="field" name="review"><option value="">All references</option><option value="metadata-checked">Metadata checked</option><option value="image-transcribed">Image-transcribed stats</option><option value="metadata-not-reviewed">Gallery reference only</option></select></label><label class="field-label"><span>Source gallery</span><select class="field" name="gallery"><option value="">Any gallery</option>{options('gallery_sources').map(v=><option>{v}</option>)}</select></label></>}
      {kind==='spells'&&<><label class="field-label"><span>Enemy saving throw</span><select class="field" name="save"><option value="">Any save / test</option>{['STR','DEX','CON','INT','WIS','CHA'].map(v=><option>{v}</option>)}</select></label><label class="check-control"><input type="checkbox" name="longrange" value="1"/>120 ft or more / sight / unlimited</label></>}
    </div></details>
    <button class="button" type="reset">Clear filters</button>
  </form>
  <div class="catalog-toolbar toolbar"><p class="control-note" role="status" data-catalog-count>{notes.length} entries</p><div><label class="sort-control">Sort <select class="field" data-catalog-sort><option value="title">Name A–Z</option>{kind==='spells'&&<option value="level">Level, then name</option>}{kind==='items'&&<option value="rarity_rank">Rarity, then name</option>}{kind==='forms'&&<option value="cr">CR, then name</option>}</select></label><button class="button" type="button" data-catalog-view aria-pressed="false">Read rows</button></div></div>
  <div class="data-table table-wrap catalog-wrap" tabindex="0" role="region" aria-label={`${kind} comparison table`}><table class="catalog-table"><thead><tr><th scope="col">Compare</th><th scope="col">{kind==='spells'?'Spell':kind==='items'?'Item':'Creature'}</th>{columns.map(c=><th scope="col">{c.label}</th>)}</tr></thead><tbody>{notes.map(n=><tr data-catalog-row data-note={n.slug} data-record={JSON.stringify(catalogFilters(n))}><td data-label="Compare"><input type="checkbox" data-compare-note value={n.slug} aria-label={`Compare ${n.title}`}/></td><td class="table-identity" data-label="Name"><a href={noteHref(n)} data-catalog-reference={noteHref(n)}>{n.title}</a><span class="catalog-summary">{n.summary}</span>{catalogNotes(n).map(note=><span class="catalog-summary catalog-stat-note">Stat-block note: {note}</span>)}</td>{columns.map(c=><td data-label={c.label}>{catalogValue(n,c.key)}</td>)}</tr>)}</tbody></table></div>
  <div class="empty-state" data-catalog-empty hidden><h2>No matching entries</h2><p>Try a different combination of filters.</p></div>
  <div class="compare-bar" data-compare-bar hidden><span role="status" data-compare-count></span><a class="button button--primary" data-compare-link href="/compare/">Compare selected</a><button class="button" type="button" data-compare-clear>Clear selection</button></div>
  <noscript><p>Every entry is available above. Enable JavaScript to filter and compare.</p></noscript>
</section>
<script>
  import {normalizeSearch} from '@/lib/search';
  import {rememberFinderContext} from '@/lib/finder-context';
  const root=document.querySelector<HTMLElement>('[data-catalog]');
  if(root){const form=root.querySelector<HTMLFormElement>('[data-catalog-filters]')!,fields=[...form.querySelectorAll<HTMLInputElement|HTMLSelectElement>('[name]')];const rows=[...root.querySelectorAll<HTMLElement>('[data-catalog-row]')].map(el=>({el,data:JSON.parse(el.dataset.record!)}));const params=new URLSearchParams(location.search);for(const f of fields){if(f instanceof HTMLInputElement&&f.type==='checkbox')f.checked=params.get(f.name)==='1';else f.value=params.get(f.name)??'';}
    const sort=root.querySelector<HTMLSelectElement>('[data-catalog-sort]')!;sort.value=params.get('sort')??'title';if(!sort.value)sort.value='title';const selected=new Set((params.get('compare')??'').split(',').filter(v=>rows.some(r=>r.el.dataset.note===v)).slice(0,4));const checks=[...root.querySelectorAll<HTMLInputElement>('[data-compare-note]')];for(const c of checks)c.checked=selected.has(c.value);
    const view=root.querySelector<HTMLButtonElement>('[data-catalog-view]')!,wrapper=root.querySelector('.catalog-wrap')!;
    const setView=(active:boolean)=>{wrapper.classList.toggle('table-row-view',active);view.setAttribute('aria-pressed',String(active));view.textContent=active?'Compare columns':'Read rows';};setView(params.get('view')==='rows');
    const value=(name:string)=>{const f=fields.find(f=>f.name===name);return f instanceof HTMLInputElement&&f.type==='checkbox'?f.checked?'1':'':f?.value??'';};
    function update(){const q=normalizeSearch(value('q')).split(/\s+/).filter(Boolean);let count=0;for(const r of rows){const d=r.data;const allowed=q.every(t=>d.text.includes(t))&&(!value('level')||String(d.level)===value('level'))&&(!value('school')||d.school===value('school'))&&(!value('focus')||d.focus.includes(value('focus')))&&(!value('source')||d.source_group===value('source'))&&(!value('role')||d.roles?.includes(value('role')))&&(!value('save')||d.save?.includes(value('save')))&&(!value('rarity')||d.rarity===value('rarity'))&&(!value('attunement')||String(d.attunement)===value('attunement'))&&(!value('route')||d[value('route')]===true)&&(!value('movement')||d.movement.includes(value('movement')))&&(!value('senses')||d.senses.includes(value('senses')))&&(!value('review')||d.review===value('review'))&&(!value('gallery')||d.gallery_sources?.includes(value('gallery')))&&(!value('maxcr')||(d.cr!=null&&Number(d.cr)<=Number(value('maxcr'))))&&(!value('longrange')||(d.range_feet>=120||['unlimited','sight'].includes(d.range_kind)));r.el.hidden=!allowed;if(allowed)count++;}
      root!.querySelector('[data-catalog-count]')!.textContent=`${count} ${root!.dataset.catalog==='spells'?'spell':root!.dataset.catalog==='items'?'item':'form'}${count===1?'':'s'}`;(root!.querySelector('[data-catalog-empty]')as HTMLElement).hidden=count>0;const body=root!.querySelector('tbody')!;const sorted=[...rows].sort((a,b)=>sort.value==='title'?a.data.title.localeCompare(b.data.title):(Number(a.data[sort.value]??Infinity)-Number(b.data[sort.value]??Infinity))||a.data.title.localeCompare(b.data.title));for(const r of sorted)body.append(r.el);const url=new URL(location.href);for(const f of fields){const v=value(f.name);if(v)url.searchParams.set(f.name,v);else url.searchParams.delete(f.name);}if(sort.value!=='title')url.searchParams.set('sort',sort.value);else url.searchParams.delete('sort');if(selected.size)url.searchParams.set('compare',[...selected].join(','));else url.searchParams.delete('compare');if(wrapper.classList.contains('table-row-view'))url.searchParams.set('view','rows');else url.searchParams.delete('view');history.replaceState(null,'',url);
      const context=rememberFinderContext(url.href,location.origin)??url.pathname;
      for(const link of root!.querySelectorAll<HTMLAnchorElement>('[data-catalog-reference]')){const target=new URL(link.dataset.catalogReference!,location.origin);target.searchParams.set('returnTo',context);link.href=target.pathname+target.search;}
      const comparison=new URL('/compare/',location.origin);comparison.searchParams.set('notes',[...selected].join(','));comparison.searchParams.set('returnTo',context);(root!.querySelector('[data-compare-link]')as HTMLAnchorElement).href=comparison.pathname+comparison.search;
    }
    function updateCompare(){const bar=root!.querySelector<HTMLElement>('[data-compare-bar]')!;bar.hidden=!selected.size;root!.querySelector('[data-compare-count]')!.textContent=`${selected.size} selected · choose up to 4`;update();}
    form.addEventListener('submit',e=>{e.preventDefault();update()});form.addEventListener('input',update);form.addEventListener('reset',()=>setTimeout(update));sort.addEventListener('change',update);for(const c of checks)c.addEventListener('change',()=>{if(c.checked&&selected.size>=4){c.checked=false;root!.querySelector('[data-compare-count]')!.textContent='Choose up to 4 entries. Remove one to add another.';return;}if(c.checked)selected.add(c.value);else selected.delete(c.value);updateCompare()});root.querySelector('[data-compare-clear]')!.addEventListener('click',()=>{selected.clear();checks.forEach(c=>c.checked=false);updateCompare()});view.addEventListener('click',()=>{setView(!wrapper.classList.contains('table-row-view'));update();});updateCompare();
  }
</script>
